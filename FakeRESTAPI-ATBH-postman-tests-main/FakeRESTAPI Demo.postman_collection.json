        {
          "name": "Create Author",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const randomId = Math.floor(Math.random() * 100000);\r",
                  "pm.environment.set(\"randomAuthorId\", randomId);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is successful\", function () {\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is JSON\", function () {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Created Author firstName is Amer\",function() {\r",
                  "    const data = pm.response.json();\r",
                  "    pm.expect(data.firstName).to.eql(\"Amer\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Created Author lastName is Civic\", function () {\r",
                  "    const data = pm.response.json();\r",
                  "    pm.expect(data.lastName).to.eql(\"Civic\");\r",
                  "});\r",
                  "\r",
                  "const data = pm.response.json();\r",
                  "pm.environment.set(\"authorId\", data.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"id\": {{randomAuthorId}},\r\n  \"idBook\": 11,\r\n  \"firstName\": \"Amer\",\r\n  \"lastName\": \"Civic\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseurl}}/Authors",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "Authors"
              ]
            }
          },
          "response": []
